+bool llama_sampler_grammar_is_awaiting_trigger(
+        const struct llama_sampler * smpl) {
+
+    if (!smpl) {
+        return false;
+    }
+
+    const auto * ctx =
+        (const llama_sampler_grammar *) smpl->ctx;
+
+    return
+        ctx->grammar != nullptr &&
+        ctx->grammar->awaiting_trigger;
+}
